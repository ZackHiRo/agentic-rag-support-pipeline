# Copy to .env and fill in. .env is gitignored.

OPENAI_API_KEY=sk-...

# ── Support platform ──────────────────────────────────────────────────────────
# mock = realistic answers built from the KB, no LLM calls (free; the default)
# live = run the real multi-agent pipeline (uses your API key)
PIPELINE_MODE=live
# MOCK_STAGE_DELAY=0.9           # seconds per stage in mock mode
# AI_ASSISTANT_NAME=Alex         # the AI's name; replies always say it's an AI ("Alex, AI Support Assistant")
# LLM_TIMEOUT_SECONDS=60         # per-request timeout (the SDK default is 10 minutes)
# LLM_MAX_RETRIES=2

# Sign cookies and magic links. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# DATABASE_URL=sqlite:///data/everdawn.db     # or postgresql+psycopg://user:pass@host/db
# DEV_MAGIC_LINKS=true           # show sign-in links in the UI instead of emailing them (no mail server)
# STAFF_DEMO_PASSWORD=everdawn-demo   # password for the seeded console accounts
# AI_WORKERS=2                   # concurrent AI runs
# PENDING_REMINDER_DAYS=3
# PENDING_AUTOSOLVE_DAYS=7
# SOLVED_AUTOCLOSE_DAYS=4

# ── Provider selection ────────────────────────────────────────────────────────
#
# LLM_PROVIDER sets the default provider for ALL agents.
# Per-agent overrides (e.g. SAFETY_LLM_PROVIDER) are also supported.
#
# Valid values: openai | anthropic | ollama | openai_compatible
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...          (set above)

# ── Anthropic ─────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local / free) ─────────────────────────────────────────────────────
# LLM_BASE_URL=http://localhost:11434/v1
# FORCE_JSON_MODE=true           # most local models need this instead of native struct output

# ── OpenAI-compatible (Together, Groq, Fireworks, etc.) ──────────────────────
# LLM_BASE_URL=https://api.together.xyz/v1
# OPENAI_API_KEY=<together-api-key>

# ── Per-agent model names ─────────────────────────────────────────────────────
# These are the model names sent to whichever provider is active.
# For Anthropic, use claude-* names. For Ollama, use llama3.1:8b etc.

# Drafting agents: Internal Note + Player Reply (long-form generation)
OPENAI_MODEL=gpt-4.1

# Classifier + Steps agent (extractive / classification — cheap model OK)
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini

# Safety agent — PII/escalation/threat detection (cheap model OK)
# Defaults to OPENAI_CLASSIFIER_MODEL if not set.
# OPENAI_SAFETY_MODEL=gpt-4.1-mini

# Next Steps agent override (defaults to OPENAI_CLASSIFIER_MODEL)
# OPENAI_STEPS_MODEL=gpt-4.1-mini

# QA agent — needs full reasoning capability (use strongest available)
# Defaults to OPENAI_MODEL if not set.
# OPENAI_QA_MODEL=gpt-4.1

# Vision model — must support image input (OpenAI only for now)
OPENAI_VISION_MODEL=gpt-4.1-mini

# ── Per-agent provider overrides ─────────────────────────────────────────────
# Useful for mixing providers, e.g. cheap classification on Ollama + drafting on OpenAI:
#   CLASSIFIER_LLM_PROVIDER=ollama
#   SAFETY_LLM_PROVIDER=ollama
#   NOTE_LLM_PROVIDER=openai
#   REPLY_LLM_PROVIDER=openai
#   STEPS_LLM_PROVIDER=ollama
#   QA_LLM_PROVIDER=openai

# ── Per-agent JSON-mode override ─────────────────────────────────────────────
# Set true for models that don't support native structured output (most Ollama models):
# SAFETY_FORCE_JSON_MODE=true
# NOTE_FORCE_JSON_MODE=true
# REPLY_FORCE_JSON_MODE=true
# STEPS_FORCE_JSON_MODE=true
# QA_FORCE_JSON_MODE=true
# CLASSIFIER_FORCE_JSON_MODE=true

# ── LLM output limits ─────────────────────────────────────────────────────────
# Max output tokens per agent call. 4096 is safe for all agents.
# Raise to 8192 if you get truncated outputs on complex tickets.
LLM_MAX_TOKENS=4096

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_DIR=.chroma

# ── Retrieval knobs ───────────────────────────────────────────────────────────
RETRIEVE_TOP_K=8
RETRIEVE_FINAL_K=4

# How many top-matched articles get their Investigation/Procedures/Escalation
# sections force-included in context. Lower to 1 if hitting rate limits.
ROLE_BOOST_ARTICLES=2
